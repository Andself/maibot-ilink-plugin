{
  "manifest_version": 2,
  "id": "anse.ilink",
  "version": "0.12.1",
  "name": "微信 iLink 多账号私聊",
  "description": "基于腾讯公开 iLink 协议的 MaiBot 多账号私聊、图片表情包与邀请管理插件。非腾讯认证插件。",
  "author": {
    "name": "Andself",
    "url": "https://github.com/Andself"
  },
  "urls": {
    "repository": "https://github.com/Andself/maibot-ilink-plugin",
    "homepage": "https://github.com/Andself/maibot-ilink-plugin",
    "documentation": "https://github.com/Andself/maibot-ilink-plugin#readme"
  },
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "license": "MIT",
  "host_application": {
    "min_version": "1.3.14",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "qrcode",
      "version_spec": ">=8.2,<9"
    },
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=10,<14"
    },
    {
      "type": "python_package",
      "name": "cryptography",
      "version_spec": ">=43,<51"
    }
  ],
  "capabilities": [
    "platform:weixin_ilink",
    "gateway:duplex",
    "message:text",
    "message:image",
    "chat.get_private_streams",
    "send.text",
    "chat.open_session"
  ]
}
